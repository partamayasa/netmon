# Application Settings
APP_NAME="Home Internet Monitoring System"
APP_SHORT_NAME="Internet Monitoring"
APP_TIMEZONE="Asia/Makassar"

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_TABLE_LOGS=internet_logs
DB_TABLE_USERS=users

# Initial Administrator Credentials (Auto-seed if table is empty)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=your_admin_password
ADMIN_DEFAULT_NAME=Administrator
